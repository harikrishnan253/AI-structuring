# S4Carlisle Pre-Editor v3 Configuration
# Copy this to .env and update values

# ============================================
# Required
# ============================================
GOOGLE_API_KEY=your_google_api_key_here

# ============================================
# Queue Mode
# ============================================
# threading = Simple mode, no external services (for development)
# celery = Production mode with Redis (recommended)
QUEUE_MODE=celery

# ============================================
# Redis (required for celery mode)
# ============================================
# Local dev (no Docker): redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# ============================================
# Database
# ============================================
# Docker Compose (PostgreSQL service name: postgres)
DATABASE_URL=postgresql+psycopg2://ai_structuring:ai_structuring_pass@postgres:5432/ai_structuring

# ============================================
# Flask Configuration
# ============================================
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-long-random-string

# ============================================
# Paths
# ============================================
# These can be relative (recommended for local dev) or absolute.
# Docker Compose defaults (if you want absolute paths):
#   UPLOAD_FOLDER=/app/uploads
#   OUTPUT_FOLDER=/app/outputs
#   DATABASE_PATH=/app/data/dev.db
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
# Only used when DATABASE_URL is NOT set (SQLite dev fallback)
DATABASE_PATH=dev.db

# ============================================
# Flower (Celery monitoring)
# ============================================
# Format: user:password
FLOWER_BASIC_AUTH=admin:change-me

# ============================================
# Processing Settings
# ============================================
CONFIDENCE_THRESHOLD=85
MAX_PARAGRAPHS_PER_CHUNK=100

# ============================================
# LLM Invocation Control (Evaluation/Testing)
# ============================================
# FORCE_LLM=true bypasses cache and rule-based short-circuits to guarantee
# at least one LLM API call per document. This is useful for:
# - Evaluation runs to measure true LLM performance
# - Testing LLM behavior without cache interference
# - Cost/token usage analysis
# Default: false (respects cache and rules for cost optimization)
FORCE_LLM=false

# ============================================
# Grounded Retriever (Few-Shot / Tag Fallback)
# ============================================
# Master toggle.  When false (default) ground_truth.jsonl is never opened
# at runtime and there is no corpus dependency.
# Set to true only in dev/experiment environments that have a ground_truth file.
ENABLE_GROUNDED_RETRIEVER=false

# Mode — only relevant when ENABLE_GROUNDED_RETRIEVER=true.
#   off                  disable after loading (warmup/testing only)
#   prompt_examples      inject similar tagged examples into the LLM prompt
#   invalid_tag_fallback use corpus similarity to recover unknown tag outputs
GROUNDED_RETRIEVER_MODE=prompt_examples

# Rule-learner — learned_rules.json is optional by default.
# Set to true to treat a missing rules file as a fatal startup error.
REQUIRE_LEARNED_RULES=false
